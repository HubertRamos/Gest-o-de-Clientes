# ==============================================================================
# Banco de Dados
# ==============================================================================
# Modo do banco de dados: "local" (SQLite) ou "supabase" (PostgreSQL do Supabase)
DATABASE_MODE=local

# Para modo local (SQLite):
DATABASE_URL=sqlite:///./data/delivery_system.db

# Para modo supabase (PostgreSQL):
# DATABASE_MODE=supabase
# DATABASE_URL=postgresql+psycopg://postgres.[PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# Servidor e CORS
# ==============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Integração WhatsApp Business Cloud API (Meta)
# ==============================================================================
# Modo inicial: "simulation" (não envia mensagens reais)
# Quando as credenciais oficiais estiverem configuradas: "meta_cloud"
WHATSAPP_PROVIDER_MODE=simulation

# Credenciais oficiais da Meta (deixar vazias enquanto estiver em simulação)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
